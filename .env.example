# Symphony env file template — copy to .env and populate.
#
# Recommended path on MyBCAT machines: do not paste secrets here directly.
# Instead, run:
#   /mnt/d_drive/repos/finances/scripts/secret_exec.py \
#       --emit-env-file .env mybcat/symphony
# which materialises secrets from AWS Secrets Manager into this file.
#
# .env is gitignored. Anything you put here will not be committed.

# ---- Tracker (one of MONDAY_API_TOKEN or LINEAR_API_KEY is required) -------
MONDAY_API_TOKEN=
LINEAR_API_KEY=

# ---- Optional model API keys (only needed if a CLI is configured to use
#      direct API auth rather than its native OAuth flow) -------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Path overrides (rarely needed) ----------------------------------------
# Where Symphony writes per-issue workspaces on the host. Defaults to
# ./_symphony_workspaces relative to the repo root.
# SYMPHONY_WORKSPACE_HOST_DIR=

# Host directory containing claude/codex/gemini binaries or thin wrappers,
# mounted into the container at /opt/symphony/cli (which is on PATH).
# Defaults to ./bin.
# SYMPHONY_HOST_CLI_DIR=

# Names / paths used inside the container when WORKFLOW.md interpolates
# $CODEX_BIN / $CLAUDE_BIN / $GEMINI_BIN.
# CODEX_BIN=codex
# CLAUDE_BIN=claude
# GEMINI_BIN=gemini
